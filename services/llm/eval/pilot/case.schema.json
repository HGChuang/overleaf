{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overleaf-copilot-pilot-case-v1",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "case_family_id",
    "split",
    "category",
    "capabilities",
    "difficulty",
    "fixture",
    "project_complexity",
    "user_goal",
    "initial_state",
    "expected_behavior",
    "forbidden_behavior",
    "patch_policy",
    "compile_policy",
    "graders",
    "validation_oracle",
    "harness",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+\\.v[0-9]+$"
    },
    "case_family_id": { "type": "string", "minLength": 3 },
    "split": { "enum": ["dev", "holdout"] },
    "category": { "type": "string", "minLength": 2 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "C1",
          "C2",
          "C3",
          "C4",
          "C5",
          "C6",
          "C7",
          "C8",
          "C9",
          "C10",
          "C11"
        ]
      }
    },
    "difficulty": {
      "type": "object",
      "required": ["level", "factors"],
      "properties": {
        "level": { "enum": ["D1", "D2", "D3", "D4"] },
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": [
        "fixture_id",
        "fixture_lineage",
        "main_file",
        "compiler",
        "files",
        "sha256"
      ],
      "properties": {
        "fixture_id": { "type": "string" },
        "fixture_lineage": { "type": "string" },
        "main_file": { "type": "string" },
        "compiler": { "const": "pdflatex" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string" },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "expected_behavior": {
      "type": "object",
      "required": ["action", "max_user_turns"],
      "properties": {
        "action": { "enum": ["patch", "clarify", "answer", "no_op", "refuse"] },
        "max_user_turns": { "type": "integer", "minimum": 1, "maximum": 4 },
        "continue_after_patch": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "required": ["minimum_support", "unsupported_is"],
      "properties": {
        "minimum_support": { "enum": ["H1", "H2"] },
        "unsupported_is": { "const": "skipped" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
